htmlcov/

# Node / JS (monorepo pnpm — ADR-0002)
node_modules/
dist/
build/
.expo/
.turbo/

# Build/run logs — nunca versionar (lição do monorepo MEDSoft)
*.log

# Generated audio
temp_audio/
*.mp3
*.ogg
*.wav
*.m4a
*.opus

# Exceção: o insumo de teste do STT (CARD-006). São 72 KB de voz SINTÉTICA
# (saída de `tts-1`), não de pessoa real — sem dado pessoal envolvido. Fica
# versionado porque sem ele o critério de aceite do adapter de STT só é
# verificável na máquina de quem gravou o áudio.
!backend/tests/fixtures/stt/*.wav

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code — versionar commands/ e skills/, ignorar apenas settings locais
.claude/settings.local.json

# Vozes do Piper (CARD-008): 60 MB por voz, artefato baixado por comando, não
# código. `benchmarks/README.md` diz como obtê-las.
backend/benchmarks/voices/
backend/voices/

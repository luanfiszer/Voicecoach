# Copie para `.env` na raiz do repositório: `cp .env.example .env`
#
# Este arquivo é lido por dois consumidores diferentes:
#   1. o docker compose (substituição ${VAR} no docker-compose.yml);
#   2. o backend, via pydantic-settings (voicecoach.config.Settings).
# Por isso ele mistura variáveis de infra (portas do host) e de aplicação.
#
# `.env` está no .gitignore. Só este `.env.example` é versionado — nunca
# coloque segredo real aqui.

# --- Segredo obrigatório -----------------------------------------------------
# Única variável SEM default: o backend recusa subir sem ela (ADR-0013).
# Chave do console da Anthropic. ADR-0010: configure também o spend limit
# mensal lá (ex.: US$ 10) e deixe o auto-reload desligado.
ANTHROPIC_API_KEY=

# --- Modelos de IA (ADR-0009, ajustado pelo ADR-0010) ------------------------
# Default de desenvolvimento é o modelo barato. Sonnet fica para o modo
# qualidade e para o eval (P5) — trocar o modelo do professor sem rodar o eval
# é proibido pelo ADR-0009.
TEACHER_MODEL=claude-haiku-4-5
ASSISTANT_MODEL=claude-haiku-4-5

# --- Proteção de custo (ADR-0010, visão §D) ----------------------------------
# Ainda sem consumidor: as quotas entram no CARD-015 e o custo real no
# CARD-014. Declaradas aqui porque são contrato de configuração do produto.
DAILY_AUDIO_MINUTES_PER_STUDENT=10
DAILY_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=10.00

# --- Postgres (ADR-0004) -----------------------------------------------------
# DATABASE_URL usa o dialeto do SQLAlchemy (postgresql+asyncpg://) porque é
# isso que o CARD-005 vai consumir. Precisa bater com POSTGRES_* abaixo.
DATABASE_URL=postgresql+asyncpg://voicecoach:voicecoach@localhost:5432/voicecoach
POSTGRES_USER=voicecoach
POSTGRES_PASSWORD=voicecoach
POSTGRES_DB=voicecoach
POSTGRES_PORT=5432

# --- Redis (ADR-0005) --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Storage de mídia: MinIO local, API S3 (ADR-0006) ------------------------
# S3_ACCESS_KEY/S3_SECRET_KEY viram MINIO_ROOT_USER/PASSWORD no compose.
# Senha do MinIO exige no mínimo 8 caracteres.
# TTS local (ADR-0032). A voz NÃO vem no pacote: baixe antes de rodar o worker
#   uv run python -m piper.download_voices en_US-lessac-medium --download-dir voices
# Voz ausente faz o processo falhar na subida, dizendo qual arquivo falta.
TTS_PROVIDER=piper
TTS_VOICE=en_US-lessac-medium
TTS_VOICES_DIR=voices

S3_ENDPOINT_URL=http://localhost:9000

# O host com que as URLs de mídia são ASSINADAS (ADR-0045). Vazio = o mesmo do
# S3_ENDPOINT_URL, que é o certo para Simulador e CI.
#
# **Em APARELHO FÍSICO isto é obrigatório.** Para o telefone, `localhost` é o
# próprio telefone: aponte para o IP da sua máquina na LAN. E não adianta o app
# reescrever o host — o `Host` entra na assinatura SigV4, e trocá-lo depois dá
# 403 SignatureDoesNotMatch. Aponte também o `apiBaseUrl` de
# `apps/mobile/app.json > extra` para o mesmo IP, ou o turn nem começa.
#
# S3_PUBLIC_ENDPOINT_URL=http://192.168.0.10:9000
S3_ACCESS_KEY=voicecoach
S3_SECRET_KEY=voicecoach-dev-secret
S3_BUCKET=voicecoach-media
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- STT local (ADR-0011, ADR-0027) ------------------------------------------
# `auto` resolve pela plataforma no BOOT: mlx em Apple Silicon (0,59 s no
# small.en), faster-whisper no resto (1,18 s). Valores: auto | mlx |
# faster_whisper | openai.
#
# Escolha explícita incompatível FALHA na subida, com mensagem nomeando a
# plataforma — nunca cai para o outro adapter, porque isso esconderia uma
# regressão de 2x de latência atrás de um log.
#
# `mlx` exige o extra opcional: `uv sync --extra mlx` (só Apple Silicon).
STT_PROVIDER=auto

# Os dois adapters NÃO compartilham a string do modelo: aqui é o nome
# CTranslate2, abaixo é o repositório do Hugging Face com os pesos convertidos.
# `small.en` é o default e a escolha de modelo está BLOQUEADA (ADR-0027, item 7)
# até haver insumo com voz real de aprendiz — latência está medida, qualidade não.
STT_MODEL_FASTER_WHISPER=small.en
STT_MODEL_MLX=mlx-community/whisper-small.en-mlx

# --- Observabilidade (profile opcional) --------------------------------------
# Só usadas com `docker compose --profile observability up`.
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

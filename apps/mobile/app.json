{
  "expo": {
    "name": "Voicecoach",
    "slug": "voicecoach",
    "scheme": "voicecoach",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luanfiszer.voicecoach",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "O Voicecoach fala com o servidor de desenvolvimento na sua rede local — sem isso, a aula não sai do aparelho."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "O Voicecoach é uma aula de inglês por voz — sem microfone não há aula.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.186837573955-k2bp56b3rv9kj37cg3qbk580rikaichb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "limiteGravacaoSegundos": 90,
      "sseHabilitado": true,
      "respostaTravadaEmSegundos": 30,
      "googleIosClientId": "186837573955-k2bp56b3rv9kj37cg3qbk580rikaichb.apps.googleusercontent.com"
    }
  }
}

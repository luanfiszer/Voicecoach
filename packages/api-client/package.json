{
  "name": "@voicecoach/api-client",
  "private": true,
  "version": "0.0.0",
  "description": "Contrato do backend (ADR-0008): tipos gerados do OpenAPI — não editar à mão — e o client HTTP fino.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "~6.0.3"
  },
  "license": "UNLICENSED"
}
